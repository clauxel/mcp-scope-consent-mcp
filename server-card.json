{
  "name": "mcpscopeconsent",
  "title": "MCP Scope Consent",
  "description": "A paid remote MCP for MCP consent scope receipt, built to return verdicts, receipts, usage logs, and audit-ready JSON for agent and CI workflows.",
  "version": "1.0.0",
  "websiteUrl": "https://mcpscopeconsent.clauxel.com/",
  "documentationUrl": "https://mcpscopeconsent.clauxel.com/mcp/",
  "endpointUrl": "https://mcpscopeconsent.clauxel.com/mcp",
  "transport": "streamable-http",
  "authentication": {
    "type": "bearer",
    "required": true,
    "header": "Authorization",
    "format": "Bearer <paid-token>"
  },
  "paidAccess": {
    "required": true,
    "checkoutUrl": "https://mcpscopeconsent.clauxel.com/api/agent-checkout",
    "tokenStatusUrl": "https://mcpscopeconsent.clauxel.com/api/mcp-token/status",
    "tokenClaimUrl": "https://mcpscopeconsent.clauxel.com/api/mcp-token/claim",
    "defaultPlan": "team",
    "pricing": [
      {
        "id": "starter",
        "name": "Starter",
        "monthlyUsd": 49
      },
      {
        "id": "team",
        "name": "Team",
        "monthlyUsd": 149
      },
      {
        "id": "scale",
        "name": "Scale",
        "monthlyUsd": 399
      }
    ]
  },
